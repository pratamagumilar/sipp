generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  ADMIN_PENGAJUAN
  STAKEHOLDER
  FINANCE
  PEKERJA
}
enum SpkTrigger {
  AFTER_RAB_APPROVED
  MANUAL_FINANCE
}
enum SpkStatus {
  PENDING
  ISSUED
}
enum Status {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}
model User {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean @default(true)
  occupation   String @default("")
  jobs         Job[]
  audits       AuditLog[]
  rabAudits    RabAudit[]
  spkAudits    SpkAudit[]
  acknowledgements Spk[]
  settingAudits SettingAudit[]
  assignments AssignmentMember[]
  assignmentAudits AssignmentAudit[]
  progressUpdates Assignment[] @relation("ProgressActor")
}
model Job {
  id              String @id @default(cuid())
  title           String
  description     String
  estimatedCost   Decimal? @db.Decimal(18, 2)
  agenda          String @default("")
  applicant       String @default("")
  installationOwner String @default("")
  installationTypeCode String?
  installationType InstallationType? @relation(fields: [installationTypeCode], references: [code], onDelete: Restrict)
  capacity        Decimal? @db.Decimal(24, 6)
  capacityUnit    String @default("")
  location        String @default("")
  offerValue      Decimal? @db.Decimal(18, 2)
  status          Status @default(DRAFT)
  version         Int @default(0)
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ownerId         String
  owner           User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  attachments     Attachment[]
  audits          AuditLog[]
  rab             Rab?
  @@index([ownerId, createdAt])
  @@index([status, createdAt])
  @@index([installationTypeCode])
}

enum RabStatus {
  RAB_DRAFT
  RAB_REVIEW
  RAB_APPROVED
}

model Rab {
  id        String @id @default(cuid())
  jobId     String @unique
  job       Job @relation(fields: [jobId], references: [id], onDelete: Restrict)
  status    RabStatus @default(RAB_DRAFT)
  version   Int @default(0)
  notes     String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     RabItem?
  audits    RabAudit[]
  spkTrigger SpkTrigger?
  spk       Spk?
}

model Setting {
  id String @id
  spkTrigger SpkTrigger @default(MANUAL_FINANCE)
  version Int @default(0)
  audits SettingAudit[]
}

model SettingAudit {
  id String @id @default(cuid())
  settingId String
  setting Setting @relation(fields: [settingId], references: [id], onDelete: Restrict)
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  fromTrigger SpkTrigger
  toTrigger SpkTrigger
  createdAt DateTime @default(now())
  @@index([settingId, createdAt])
}

model Spk {
  id String @id @default(cuid())
  rabId String @unique
  rab Rab @relation(fields: [rabId], references: [id], onDelete: Restrict)
  status SpkStatus @default(PENDING)
  number String? @unique
  amount Decimal? @db.Decimal(18, 2)
  acknowledgedById String?
  acknowledgedBy User? @relation(fields: [acknowledgedById], references: [id], onDelete: Restrict)
  acknowledgedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  audits SpkAudit[]
  assignment Assignment?
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum AssignmentRole {
  Ketua
  Anggota
}

model Assignment {
  id String @id @default(cuid())
  spkId String @unique
  spk Spk @relation(fields: [spkId], references: [id], onDelete: Restrict)
  number String @unique
  consideration String
  basis String
  purpose String
  installationType String
  start DateTime @db.Date
  end DateTime @db.Date
  owner String
  location String
  capacity String
  issuePlace String
  issueDate DateTime @db.Date
  signatory String
  signatoryTitle String
  version Int @default(0)
  status AssignmentStatus @default(ASSIGNED)
  progressPercent Int @default(0)
  progressNotes String @default("")
  progressUpdatedAt DateTime?
  progressUpdatedById String?
  progressUpdatedBy User? @relation("ProgressActor", fields: [progressUpdatedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members AssignmentMember[]
  audits AssignmentAudit[]
}

model AssignmentMember {
  id String @id @default(cuid())
  assignmentId String
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  name String
  occupation String
  role AssignmentRole
  position Int
  @@unique([assignmentId, userId])
  @@unique([assignmentId, position])
  @@index([userId])
}

model AssignmentAudit {
  id String @id @default(cuid())
  assignmentId String
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  event String
  fromStatus AssignmentStatus?
  toStatus AssignmentStatus
  snapshot Json?
  createdAt DateTime @default(now())
  @@index([assignmentId, createdAt])
}

model SpkAudit {
  id String @id @default(cuid())
  spkId String
  spk Spk @relation(fields: [spkId], references: [id], onDelete: Restrict)
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  event String
  createdAt DateTime @default(now())
  @@index([spkId, createdAt])
}

model RabItem {
  rabId                 String @id
  rab                   Rab @relation(fields: [rabId], references: [id], onDelete: Restrict)
  fixCost               Decimal? @db.Decimal(18, 2)
  sppjTransport         Decimal? @db.Decimal(18, 2)
  nidi                  Decimal? @db.Decimal(18, 2)
  izinEsdm              Decimal? @db.Decimal(18, 2)
  lhpp                  Decimal? @db.Decimal(18, 2)
  pnbp                  Decimal? @db.Decimal(18, 2)
  verifikator           Decimal? @db.Decimal(18, 2)
  sewaAlat              Decimal? @db.Decimal(18, 2)
  variabelCost          Decimal? @db.Decimal(18, 2)
  ppn                   Decimal? @db.Decimal(18, 2)
  jumlahNilaiPekerjaan  Decimal? @db.Decimal(18, 2)
  biayaOperasional      Decimal? @db.Decimal(18, 2)
  rencanaMargin         Decimal? @db.Decimal(18, 2)
}

model RabAudit {
  id         String @id @default(cuid())
  rabId      String
  rab        Rab @relation(fields: [rabId], references: [id], onDelete: Restrict)
  actorId    String
  actor      User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  fromStatus RabStatus?
  toStatus   RabStatus
  reason     String?
  createdAt  DateTime @default(now())
  @@index([rabId, createdAt])
}
model InstallationType {
  code String @id
  name String
  jobs Job[]
}
model Attachment {
  id        String @id @default(cuid())
  jobId     String
  job       Job @relation(fields: [jobId], references: [id], onDelete: Restrict)
  filename  String
  storageId String @unique
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}
model AuditLog {
  id         String @id @default(cuid())
  jobId      String
  job        Job @relation(fields: [jobId], references: [id], onDelete: Restrict)
  actorId    String
  actor      User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  fromStatus Status?
  toStatus   Status
  reason     String?
  createdAt  DateTime @default(now())
  @@index([jobId, createdAt])
}
